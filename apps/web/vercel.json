{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm build:packages && pnpm --filter @goprivate/web build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages/protocol ../../packages/crypto ../../packages/sdk ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml"
}
