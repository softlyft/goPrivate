{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@goprivate/config": ["../../packages/config/src/index.ts"],
      "@goprivate/protocol": ["../../packages/protocol/src/index.ts"],
      "@goprivate/crypto/native": ["../../packages/crypto/src/native-crypto.ts"],
      "@goprivate/crypto": ["../../packages/crypto/src/index.ts"],
      "@goprivate/sdk": ["../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "app.config.ts"]
}
