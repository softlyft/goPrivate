{
  "expo": {
    "name": "goPrivate",
    "slug": "goprivate-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "goprivate",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goprivate.mobile",
      "associatedDomains": ["applinks:goprivate.app", "applinks:www.goprivate.app"]
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.goprivate.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "goprivate.app",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "https",
              "host": "www.goprivate.app",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "goprivate",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "relayUrl": "wss://goprivate-relay.onrender.com/ws"
    }
  }
}
