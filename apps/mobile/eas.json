{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "pnpm": "10.34.5",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_RELAY_URL": "wss://goprivate-relay.onrender.com/ws"
      }
    },
    "production": {
      "pnpm": "10.34.5",
      "node": "22.14.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_RELAY_URL": "wss://goprivate-relay.onrender.com/ws"
      }
    }
  }
}
